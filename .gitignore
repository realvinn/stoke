node_modules/
out/
dist/
release/
.DS_Store
*.log
.vite/

# Local tool caches
.impeccable/
.playwright-mcp/
.superpowers/

# `wrangler dev`'s local state and temp directories. Nothing in here is the
# Worker — that is worker/ and wrangler.jsonc — and a dev run writes a workerd
# cache and a sqlite state tree into it every time.
.wrangler/

# Per-machine Claude Code settings. `.claude/` is otherwise tracked — the
# commands and agent definitions in it are shared — but this one file holds
# whatever permissions and paths a particular desk happened to approve.
.claude/settings.local.json

# Scratch git worktrees created for background agents. They are real checkouts
# of this same repo, so committing one records a gitlink to a commit that only
# exists locally — a clone then fails to fetch it.
.claude/worktrees/

# Stray build output. electron-vite emits the real bundle to out/main/index.js;
# this root copy is regenerated and must never be committed.
index.js
