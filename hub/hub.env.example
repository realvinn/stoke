# /etc/stoke-hub/hub.env (root:root, 0600) — read by stoke-hub.service.
# Every line is optional; the unit already sets the listen address and the
# data directory, and the edge secret comes from /etc/stoke-hub/edge-secret.

# The edge listener (cloudflared's target). Loopback. Requires the secret.
#STOKE_HUB_LISTEN=127.0.0.1:8787

# The LAN / tailnet listener. No secret; refuses anything that came through
# Cloudflare or Tailscale Funnel. Off unless set.
#STOKE_HUB_LAN=0.0.0.0:8788

# Where the hub is served. Stoke appends /hub to a bare origin, so keep this.
#STOKE_HUB_MOUNT=/hub

# debug | info | warn | error
#STOKE_HUB_LOG_LEVEL=info

# Requests per client address: a bucket of BURST, refilled at PER_SEC.
#STOKE_HUB_RATE_BURST=300
#STOKE_HUB_RATE_PER_SEC=5
