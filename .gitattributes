# This repo is worked on from both Windows and macOS, so normalise line endings
# in the repository and check out LF everywhere. Without this, files touched on
# Windows land as CRLF and every cross-machine diff is noise.
* text=auto eol=lf

# Never mangle binaries.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.node binary
*.dll binary
*.exe binary

# Batch files are the exception, and not for tidiness: cmd.exe's GOTO and CALL
# scan for a label by byte offset, and an LF-only .cmd can miss a label that
# sits across a 512-byte boundary. build/bin/stoke.cmd jumps to three.
*.cmd text eol=crlf
