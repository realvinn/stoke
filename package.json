{
  "name": "stoke",
  "version": "0.5.4",
  "description": "A bespoke desktop shell for Claude Code",
  "author": "realvinn",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build && vite build --config vite.remote.config.ts",
    "build:remote": "vite build --config vite.remote.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify:context": "node scripts/verify-context.mts",
    "verify:statusline": "node scripts/verify-statusline.mts",
    "verify:unicode": "node scripts/verify-unicode.mts",
    "verify:usage": "node scripts/verify-usage.mts",
    "verify:profiles": "node scripts/verify-profiles.mts",
    "verify:settings": "node scripts/verify-settings.mts",
    "verify:claude-config": "node scripts/verify-claude-config.mts",
    "verify:folders": "node scripts/verify-folders.mts",
    "verify:color": "node scripts/verify-color.mts",
    "verify:worklog-gate": "node scripts/verify-worklog-gate.mts",
    "verify:tabs": "node scripts/verify-tabs.mts",
    "verify:restore": "node scripts/verify-restore.mts",
    "verify:shortcuts": "node scripts/verify-shortcuts.mts",
    "verify:updates": "node scripts/verify-updates.mts",
    "verify:worklog-runner": "node scripts/verify-worklog-runner.mts",
    "verify:worklog-retry": "node scripts/verify-worklog-retry.mts",
    "verify:worklog-recall": "node scripts/verify-worklog-recall.mts",
    "verify:worklog-autoscan": "node scripts/verify-worklog-autoscan.mts",
    "verify:ssh": "node scripts/verify-ssh.mts",
    "verify:selection": "electron scripts/verify-selection.mts",
    "verify:security": "node scripts/verify-remote-security.mjs",
    "verify:extract": "node scripts/verify-extract.mjs",
    "measure:worklog": "node scripts/measure-worklog-cost.mts",
    "check": "npm run typecheck && npm run verify:context && npm run verify:statusline && npm run verify:unicode && npm run verify:usage && npm run verify:profiles && npm run verify:settings && npm run verify:claude-config && npm run verify:folders && npm run verify:color && npm run verify:worklog-gate && npm run verify:tabs && npm run verify:restore && npm run verify:shortcuts && npm run verify:updates && npm run verify:worklog-runner && npm run verify:worklog-retry && npm run verify:worklog-recall && npm run verify:worklog-autoscan && npm run verify:ssh && npm run verify:selection && npm run build",
    "icon": "electron scripts/make-icon.cjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:arm64": "npm run build && electron-builder --win --arm64",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:mac:intel": "npm run build && electron-builder --mac --x64",
    "dist:mac:universal": "npm run build && electron-builder --mac --universal"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.14",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
